# Copy to .env.local and adjust as needed:  cp .env.example .env.local

# --- Database (Drizzle + libSQL/Turso) ---
# Defaults to a local SQLite file when unset, so this is optional in dev.
TURSO_DATABASE_URL="file:./dev.db"
# Required only when pointing at a hosted Turso database.
# TURSO_AUTH_TOKEN=""

# --- Shareable links ---
# Optional. Absolute base URL used when generating shareable links. When unset
# it's derived from the incoming request headers.
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Server Actions origin allow-list (CSRF) ---
# Comma-separated host(s) you reach the app from when it's served behind a proxy
# or preview URL (host only, no protocol). Required to avoid "Invalid Server
# Actions request." in those environments; leave unset for plain localhost dev.
# Subdomain wildcards are supported, e.g. "*.preview.example.com".
# SERVER_ACTIONS_ALLOWED_ORIGINS="my-app.preview.example.com"
