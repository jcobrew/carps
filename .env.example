# Copy to .env.local and adjust as needed:  cp .env.example .env.local

# --- Database (Drizzle + libSQL/Turso) ---
# Defaults to a local SQLite file when unset, so this is optional in dev.
TURSO_DATABASE_URL="file:./dev.db"
# Required only when pointing at a hosted Turso database.
# TURSO_AUTH_TOKEN=""

# --- Shareable links ---
# Optional. Absolute base URL used when generating shareable links. When unset
# it's derived from the incoming request headers.
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Allowed origins (proxy / preview / dev tunnel) ---
# Comma-separated host(s) you reach the app from when it's NOT plain localhost —
# e.g. a proxy, preview URL, or a dev tunnel like ngrok/cloudflared (host only,
# no protocol). Opens both Next.js origin guards together: the Server Actions
# CSRF check ("Invalid Server Actions request.") and the dev-asset block on
# /_next/*. Leave unset for plain localhost dev. Subdomain wildcards are
# supported, which is ideal for tunnels whose subdomain changes each run.
# See RUN_ON_PHONE.md for the full tunnel walkthrough.
# ALLOWED_ORIGINS="*.trycloudflare.com,*.ngrok-free.app"
