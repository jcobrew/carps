# Convergence uses Supabase (Postgres). Copy this file to .env.local and paste
# your Supabase connection strings.
#
# 1. In Supabase: Project Settings → Database → Connection string
# 2. Use the "Transaction pooler" URL (port 6543, with ?pgbouncer=true) for
#    DATABASE_URL — this is what the app uses at runtime (serverless-friendly).
# 3. Use the "Direct" URL (port 5432) for DATABASE_URL_DIRECT — needed only by
#    `npm run db:push` because pgbouncer can't run DDL.

DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL_DIRECT=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
